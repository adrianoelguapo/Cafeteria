<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns = "http://javafx.com/javafx/17" xmlns:fx = "http://javafx.com/fxml/1" fx:controller = "com.akadoblee.cafeteria.MainController" spacing = "10" alignment = "CENTER" styleClass = "root">

    <Label text = "Cafetería" styleClass = "titulo"/>

    <Button fx:id = "btnIniciar" text = "Iniciar Simulación" onAction = "#iniciarSimulacion" prefWidth = "200" styleClass = "boton"/>

    <HBox spacing = "15" alignment = "CENTER">

        <VBox alignment = "CENTER" styleClass = "panel">
            <Label text = "Esperando" styleClass = "subtitulo"/>

            <StackPane>

                <ListView fx:id = "listaEsperando" prefWidth = "180" prefHeight = "300" styleClass = "list-view"/>
                
                <clip>

                    <Rectangle width = "180" height = "300" arcWidth = "20" arcHeight = "20"/>

                </clip>

            </StackPane>

        </VBox>

        <VBox alignment = "CENTER" styleClass = "panel">

            <Label text = "Atendidos" styleClass = "subtitulo"/>

            <StackPane>

                <ListView fx:id = "listaAtendidos" prefWidth = "180" prefHeight = "300" styleClass = "list-view"/>

                <clip>

                    <Rectangle width = "180" height = "300" arcWidth = "20" arcHeight = "20"/>

                </clip>

            </StackPane>

        </VBox>

        <VBox alignment = "CENTER" styleClass = "panel">

            <Label text = "Se fueron" styleClass = "subtitulo"/>

            <StackPane>

                <ListView fx:id = "listaSeFueron" prefWidth = "180" prefHeight = "300" styleClass = "list-view"/>

                <clip>

                    <Rectangle width = "180" height = "300" arcWidth = "20" arcHeight = "20"/>

                </clip>

            </StackPane>

        </VBox>

    </HBox>

    <Label fx:id = "lblEstado" text = "Esperando inicio..." styleClass = "estado"/>

</VBox>
