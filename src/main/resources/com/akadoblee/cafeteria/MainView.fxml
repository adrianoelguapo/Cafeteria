<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox alignment="CENTER" spacing="10" styleClass="root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.akadoblee.cafeteria.MainController">

    <Label styleClass="titulo" text="Cafetería" />

   <HBox alignment="CENTER" spacing="30.0">

      <children>

         <Button fx:id="btnIniciar" onAction="#iniciarSimulacion" prefWidth="200" styleClass="boton" text="Iniciar Simulación" />
      
         <Button fx:id="btnAñadirCliente" onAction="#añadirCliente" prefWidth="200" styleClass="boton" text="Dejar Pasar a Cliente" />

         <Button fx:id="btnDetenerSimulacion" onAction="#detenerSimulacion" prefWidth="200" styleClass="boton" text="Detener Simulación" />

      </children>

   </HBox>

    <HBox alignment="CENTER" spacing="15">

        <VBox alignment="CENTER" styleClass="panel">
        
            <Label styleClass="subtitulo" text="Esperando" />

            <StackPane>

                <ListView fx:id="listaEsperando" prefHeight="300" prefWidth="180" styleClass="list-view" />
                
                <clip>

                    <Rectangle arcHeight="20" arcWidth="20" height="300" width="180" />

                </clip>

            </StackPane>

        </VBox>

        <VBox alignment="CENTER" styleClass="panel">

            <Label styleClass="subtitulo" text="Atendidos" />

            <StackPane>

                <ListView fx:id="listaAtendidos" prefHeight="300" prefWidth="180" styleClass="list-view" />

                <clip>

                    <Rectangle arcHeight="20" arcWidth="20" height="300" width="180" />

                </clip>

            </StackPane>

        </VBox>

        <VBox alignment="CENTER" styleClass="panel">

            <Label styleClass="subtitulo" text="Se fueron" />

            <StackPane>

                <ListView fx:id="listaSeFueron" prefHeight="300" prefWidth="180" styleClass="list-view" />

                <clip>

                    <Rectangle arcHeight="20" arcWidth="20" height="300" width="180" />

                </clip>

            </StackPane>

        </VBox>

    </HBox>

    <Label fx:id="lblEstado" styleClass="estado" text="Esperando inicio..." />

</VBox>
